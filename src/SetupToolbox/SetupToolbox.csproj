<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SetupToolbox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <!-- Exe-icoon: zichtbaar in taskbar, Explorer, alt-tab, run-dialog. Voor
         unpackaged WinUI 3 apps wordt dit door MSBuild in de exe header gezet
         via rc.exe. Multi-resolution ICO (16/24/32/48/64/128/256) — gegenereerd
         door scripts/generate-app-icon.ps1. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- App-versie. Bump bij elke afgeronde feature (zie NEXT-STEPS.md). Zet
         AssemblyVersion + FileVersion gelijk zodat assembly metadata, exe
         properties en eventuele toekomstige in-app version-display match. -->
    <AssemblyName>SetupToolbox</AssemblyName>
    <Version>1.2.5</Version>
    <AssemblyVersion>1.2.5</AssemblyVersion>
    <FileVersion>1.2.5</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- Shared apps.json — leeft op repo-niveau zodat zowel de WPF als de WinUI
       app dezelfde curated lijst gebruiken. Wordt naast de exe gekopieerd in
       data/apps.json zodat AppDatabaseService 'm direct kan lezen.
       Distributie-model: private repo + public GitHub Releases, exe heeft
       de apps.json gebundeld dus geen netwerk fetch nodig. -->
  <ItemGroup>
    <Content Include="..\..\data\apps.json" Link="data\apps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Vertaaltabellen (v1.2.2). Zelfde bundel-patroon als apps.json: naast de
       exe in data/, gelezen door LocalizationService.
       Bewust GEEN .resw + x:Uid — dat is op unpackaged gemeten en werkt niet
       voor een taalkeuze: x:Uid volgt daar altijd de Windows-weergavetaal en er
       is geen API om die te overrulen. Zie de uitleg bovenin
       Services/LocalizationService.cs en de v1.2.2-sectie in NEXT-STEPS.md. -->
  <ItemGroup>
    <Content Include="..\..\data\strings.*.json" Link="data\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bundled app icons (128x128 PNG, transparante canvas, gecentreerd).
       Gegenereerd door scripts/fetch-icons.ps1. App.IconPath verwijst naar
       ms-appx:///Icons/<wingetId>.png. -->
  <ItemGroup>
    <Content Include="..\..\data\icons\*.png" Link="Icons\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <!-- EXACT gepind, niet 1.8.* — zie hieronder waarom beide delen nodig zijn.
         (1) Niet Version="*": dat haalt 2.x op, wat een aparte WinAppRuntime 2.x
             install op de target machine vereist ("Required components of the
             Windows App Runtime are missing — Version 2.x").
         (2) Ook niet 1.8.*: dat zweeft binnen 1.8.x. Op 2026-08-16 trok een
             restore ongevraagd 1.8.260804001 binnen, die runtime-package
             >= 8000.946.1701.0 eist terwijl de machine 8000.921.1539.0 had.
             Gevolg: de app startte niet meer ("Required components ... Version
             1.8"), en omdat het proces sterft vóór onze eerste regel code was er
             geen enkele logregel of crash.log — een lastig te herkennen fout.
         Bump dus bewust, en test daarna of de app nog start. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <!-- ToastContentBuilder voor unpackaged Win32/WinUI apps. WinAppSDK's
         eigen Microsoft.Windows.AppNotifications faalt met "Class not
         registered" zonder een COM activator class. Dit toolkit-pakket
         registreert via ToastNotificationManagerCompat automatisch een
         Start Menu shortcut + AUMID bij eerste Show(). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.*" />
    <!-- Niet gebruikt door onze eigen code — dit pint een kwetsbare transitieve
         dependency weg. Microsoft.Toolkit.Uwp.Notifications 7.1.3 trekt
         System.Drawing.Common 4.7.0 binnen (geverifieerd met `dotnet nuget why`:
         dat is het enige pad), en die versie heeft GHSA-rxg9-xrhp-64gj — een
         kritieke RCE, gepatcht vanaf 4.7.2. De DLL werd ook echt meegeleverd in
         de publish, en de toolkit gebruikt 'm live: bij de eerste Show() haalt
         ToastNotificationManagerCompat via Icon.ExtractAssociatedIcon het
         exe-icoon op voor de AUMID-registratie.
         De dependency-range van de toolkit is [4.7.0, ) — een minimum, geen
         exact — dus deze directe PackageReference wint zonder downgrade-conflict.
         Bewust 10.0.x en niet 4.7.3: die 4.x-lijn krijgt geen onderhoud meer,
         10.0.x loopt mee met onze net10.0-target en blijft gepatcht worden.
         Upgraden naar CommunityToolkit.WinUI.Notifications helpt hier NIET —
         dat pakket (7.1.2, nieuwste; geen 8.x) declareert exact dezelfde
         System.Drawing.Common [4.7.0, ). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming uit: JsonSerializer.Deserialize gebruikt reflection waardoor
         apps.json niet meer parst in een trimmed publish ("could not load
         categories"). Voor WinUI 3 unpackaged is trim sowieso fragiel — de
         XAML compiler en WinRT-bridge leunen zwaar op reflection. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>