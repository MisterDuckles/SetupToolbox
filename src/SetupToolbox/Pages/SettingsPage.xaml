<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SetupToolbox.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollView VerticalScrollBarVisibility="Auto"
                ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
        <Grid Padding="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{loc:Localize Key=settings.title}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,20" />

            <!-- ── TAAL (v1.2.2) ── -->
            <TextBlock Grid.Row="1"
                       Text="{loc:Localize Key=settings.section.language}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xF2B7;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.language.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.language.desc}" />
                    </StackPanel>

                    <!-- Items worden in code gevuld zodat "Windows volgen" de
                         actueel gedetecteerde taal kan tonen. -->
                    <ComboBox x:Name="LanguageCombo"
                              Grid.Column="2"
                              MinWidth="180"
                              VerticalAlignment="Center"
                              SelectionChanged="LanguageCombo_SelectionChanged" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="{loc:Localize Key=settings.section.autoUpdates}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <!-- Auto-update schedule card -->
            <Border Grid.Row="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE823;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.schedule.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ScheduleStatusText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Localize Key=settings.schedule.checking}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="DisableButton"
                                    Click="DisableButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="{loc:Localize Key=settings.schedule.disable}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScheduleButton"
                                    Click="ScheduleButton_Click"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" />
                                    <TextBlock x:Name="ScheduleButtonText" Text="{loc:Localize Key=settings.schedule.setUp}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Notificaties rond de geplande run (v1.0.13) -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xEA8F;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.notifications.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Localize Key=settings.notifications.desc}" />
                        </StackPanel>

                        <ToggleSwitch x:Name="UpdateNotificationsToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Toggled="UpdateNotificationsToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="5"
                       Text="{loc:Localize Key=settings.section.installation}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Manual download fallback toggle -->
            <Border Grid.Row="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE71B;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.fallback.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.fallback.desc}" />
                    </StackPanel>

                    <ToggleSwitch x:Name="FallbackToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="FallbackToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Parallel installs count (1-4) -->
            <Border Grid.Row="7"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,8,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE9F5;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.parallel.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.parallel.desc}" />
                    </StackPanel>

                    <NumberBox x:Name="ParallelCountBox"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Minimum="1"
                               Maximum="4"
                               SmallChange="1"
                               LargeChange="1"
                               SpinButtonPlacementMode="Inline"
                               ValueChanged="ParallelCountBox_ValueChanged" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="8"
                       Text="{loc:Localize Key=settings.section.uninstall}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Leftover scan after uninstall toggle -->
            <Border Grid.Row="9"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE74D;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.leftovers.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.leftovers.desc}" />
                    </StackPanel>

                    <ToggleSwitch x:Name="LeftoverToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="LeftoverToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="10"
                       Text="{loc:Localize Key=settings.section.appSelection}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Export / Import card -->
            <Border Grid.Row="11"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE159;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.selection.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SelectionStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.selection.desc}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="ExportButton"
                                Click="ExportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=common.export}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton"
                                Click="ImportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=common.import}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="SelectionResultBar"
                     Grid.Row="12"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />

            <!-- ── TWEAK-PROFIELEN (v0.9.20) ── -->
            <TextBlock Grid.Row="13"
                       Text="{loc:Localize Key=settings.section.tweakProfiles}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE713;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.profiles.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.profiles.desc}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="ProfileMakeButton"
                                Click="ProfileMakeButton_Click"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=settings.profiles.make}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProfileImportButton"
                                Click="ProfileImportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=common.import}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="TweakProfileResultBar"
                     Grid.Row="15"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />

            <!-- ── BACKUP & HERSTEL (Tweaks snapshots) ── -->
            <TextBlock Grid.Row="16"
                       Text="{loc:Localize Key=settings.section.backup}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="17"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7B8;"
                              FontSize="20"
                              VerticalAlignment="Top"
                              Margin="0,6,0,0"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{loc:Localize Key=settings.backup.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.backup.desc}" />

                        <RadioButtons x:Name="BackupModeRadios"
                                      SelectionChanged="BackupModeRadios_SelectionChanged"
                                      Margin="0,8,0,0">
                            <RadioButton Content="{loc:Localize Key=settings.backup.ask}" Tag="Ask" />
                            <RadioButton Content="{loc:Localize Key=settings.backup.always}" Tag="Always" />
                            <RadioButton Content="{loc:Localize Key=settings.backup.never}" Tag="Never" />
                        </RadioButtons>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="BrowseSnapshotsButton"
                            Click="BrowseSnapshotsButton_Click"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock x:Name="BrowseSnapshotsText" Text="{loc:Localize Key=settings.backup.browse}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── SYSTEM RESTORE POINTS (Deep Clean + Debloat) ── -->
            <TextBlock Grid.Row="18"
                       Text="{loc:Localize Key=settings.section.restorePoints}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="19"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE777;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.restore.deepClean.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DeepCleanRestorePointStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Localize Key=settings.restore.deepClean.desc}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon x:Name="DeepCleanWarningGlyph"
                                      Glyph="&#xE7BA;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      Visibility="Collapsed"
                                      ToolTipService.ToolTip="" />
                            <ToggleSwitch x:Name="DeepCleanRestoreToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                          Toggled="DeepCleanRestoreToggle_Toggled" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE777;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.restore.debloat.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DebloatRestorePointStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Localize Key=settings.restore.debloat.desc}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon x:Name="DebloatWarningGlyph"
                                      Glyph="&#xE7BA;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      Visibility="Collapsed"
                                      ToolTipService.ToolTip="" />
                            <ToggleSwitch x:Name="DebloatRestoreToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                          Toggled="DebloatRestoreToggle_Toggled" />
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="RestorePointGlobalStatus"
                             Severity="Informational"
                             IsOpen="False"
                             IsClosable="False" />

                    <!-- Restore points beheren: opent de Windows System Restore
                         wizard (rstrui.exe). Vanuit daar kan user een eerder
                         restore point selecteren en het systeem terugzetten —
                         dat zelf doen via PowerShell vereist reboot + admin en
                         is geen UX-winst tegenover de native wizard. -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7A7;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.restore.manage.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Localize Key=settings.restore.manage.desc}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="OpenSystemRestoreButton"
                                Click="OpenSystemRestoreButton_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=settings.restore.manage.openWizard}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="BackupResultBar"
                     Grid.Row="20"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />

            <!-- ── APP-UPDATES (self-update, v0.10.1) ── -->
            <TextBlock Grid.Row="21"
                       Text="{loc:Localize Key=settings.section.appUpdates}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="22"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <!-- Check op updates bij opstarten -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE72C;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.updateCheck.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Localize Key=settings.updateCheck.desc}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UpdateCheckToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Toggled="UpdateCheckToggle_Toggled" />
                    </Grid>

                    <!-- Welkomstbanner -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE946;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.welcomeBanner.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Localize Key=settings.welcomeBanner.desc}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WelcomeBannerToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                      Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Toggled="WelcomeBannerToggle_Toggled" />
                    </Grid>

                    <!-- Nu controleren -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE895;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=settings.checkNow.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <!-- Tekst komt uit code (heeft het versienummer als
                                 parameter), dus hier geen literal die anders
                                 onvertaald zou opflitsen. -->
                            <TextBlock x:Name="AppVersionText"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="CheckUpdatesButton"
                                Click="CheckUpdatesButton_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock x:Name="CheckUpdatesButtonText" Text="{loc:Localize Key=settings.checkNow.button}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="UpdateCheckResultBar"
                     Grid.Row="23"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />

            <!-- ── DIAGNOSTIEK (foutlogging) ── -->
            <TextBlock Grid.Row="24"
                       Text="{loc:Localize Key=settings.section.diagnostics}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="25"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7C3;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{loc:Localize Key=settings.logging.title}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Localize Key=settings.logging.desc}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="OpenLogFolderButton"
                                Click="OpenLogFolderButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=settings.logging.openFolder}" />
                            </StackPanel>
                        </Button>
                        <ToggleSwitch x:Name="ErrorLoggingToggle"
                                      OnContent="{loc:Localize Key=common.on}"
                                      OffContent="{loc:Localize Key=common.off}"
                                      VerticalAlignment="Center"
                                      Toggled="ErrorLoggingToggle_Toggled" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</Page>
