<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SetupToolbox.Pages.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SetupToolbox.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: titel + utility-knoppen + zoekbalk. Restore/Restart als
             volwaardige knoppen met label — de Restore-knop moet duidelijk
             vindbaar zijn. -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Localize Key=tweaks.title}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <!-- Vorige staat herstellen — alleen zichtbaar als er snapshots zijn. -->
            <Button Grid.Column="1"
                    x:Name="RestoreButton"
                    Click="RestoreButton_Click"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="{loc:Localize Key=tweaks.restoreSnapshot.tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                    <TextBlock Text="{loc:Localize Key=tweaks.restoreSnapshot}" />
                </StackPanel>
            </Button>

            <!-- Manual escape — kill explorer.exe los van Apply. -->
            <Button Grid.Column="2"
                    x:Name="RestartExplorerButton"
                    Click="RestartExplorerButton_Click"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{loc:Localize Key=tweaks.restartExplorer.tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="{loc:Localize Key=tweaks.restartExplorer}" />
                </StackPanel>
            </Button>

            <AutoSuggestBox Grid.Column="3"
                            x:Name="SearchBox"
                            PlaceholderText="{loc:Localize Key=tweaks.search.placeholder}"
                            QueryIcon="Find"
                            Width="240"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- Resultaat-bar voor apply feedback. GEEN onder-marge: een gesloten
             InfoBar blijft Visible-met-0-hoogte en zou die 12px-marge anders
             alsnog reserveren → een extra gat boven de cards t.o.v. de Apps-tab.
             Bij open feedback staat 'ie nu vlak boven de body (prima voor een
             transient melding). -->
        <InfoBar x:Name="ResultBar"
                 Grid.Row="1"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="True"
                 MaxWidth="820"
                 HorizontalAlignment="Left" />

        <Grid Grid.Row="2">
            <!-- Body: category-grid OF zoekresultaten. -->
            <ScrollView x:Name="BodyScroller"
                        VerticalScrollBarVisibility="Auto"
                        Padding="0,0,14,12"
                        ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
                <StackPanel Spacing="16">
                    <!-- Profiel-modus banner (v0.9.20) — alleen zichtbaar tijdens
                         het samenstellen van een tweak-profiel. -->
                    <InfoBar x:Name="ProfileBanner"
                             IsOpen="False"
                             IsClosable="False"
                             Severity="Informational"
                             Title="{loc:Localize Key=tweaks.profileMode.title}"
                             Message="{loc:Localize Key=tweaks.profileMode.body}" />

                    <!-- Category-grid (zichtbaar buiten search-modus). -->
                    <ItemsRepeater x:Name="CategoryGrid">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="260"
                                               MinItemHeight="150"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TweakCategoryTile">
                                <Button Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Click="CategoryTile_Click"
                                        Tag="{x:Bind Category}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{x:Bind Icon}"
                                                   FontSize="30"
                                                   Margin="0,0,0,6"
                                                   HorizontalAlignment="Left" />

                                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Blurb}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Gewone count-tekst bij gedeeltelijk toegepast. -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind CountLabel}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{x:Bind CountVisible}" />

                                            <!-- Groene "Volledig actief"-pill bij 100%. -->
                                            <Border Grid.Column="0"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind FullPillVisible}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE73E;"
                                                              FontSize="11"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Localize Key=tweaks.fullyApplied}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind PendingVisible}">
                                                <TextBlock Text="{x:Bind PendingLabel}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Zoekresultaten — platte tweak-cards, alleen tijdens search.
                         Code-behind vult SearchResultsList + toont/verbergt. -->
                    <StackPanel x:Name="SearchResultsSection"
                                Visibility="Collapsed"
                                Spacing="8">
                        <TextBlock x:Name="SearchResultsHeader"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel x:Name="SearchResultsList" Spacing="8" />
                        <TextBlock x:Name="SearchEmptyText"
                                   Text="{loc:Localize Key=tweaks.noneFound}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Profiel-modus checklist — vlakke lijst van alle tweaks
                         gegroepeerd per categorie (clean-slate). Code-behind vult
                         dit + toont/verbergt afhankelijk van App.ProfileMode. -->
                    <StackPanel x:Name="ProfileChecklist"
                                Visibility="Collapsed"
                                Spacing="8" />
                </StackPanel>
            </ScrollView>

            <!-- Loading-overlay tijdens initial state-detection / Apply. -->
            <Grid x:Name="LoadingOverlay"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="Visible">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing Width="40" Height="40" IsIndeterminate="True" />
                    <TextBlock x:Name="LoadingOverlayText"
                               Text="{loc:Localize Key=tweaks.readingState}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Globale footer: pending count + Discard + Apply. Zelfde footer
             zit op de category-detail-pagina (TweakCategoryDetailPage). -->
        <Grid Grid.Row="3"
              x:Name="NormalFooter"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0"
              Margin="0,16,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="PendingCountText"
                       Text="{loc:Localize Key=tweaks.noPendingChanges}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="DiscardButton"
                    Content="{loc:Localize Key=common.discard}"
                    IsEnabled="False"
                    Click="DiscardButton_Click"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="ApplyButton"
                    Click="ApplyButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock x:Name="ApplyButtonText" Text="{loc:Localize Key=common.apply}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Profiel-modus footer (v0.9.20) — alternatief voor NormalFooter; één
             van de twee is zichtbaar (ApplyModeChrome regelt dat). -->
        <Grid Grid.Row="3"
              x:Name="ProfileFooter"
              Visibility="Collapsed"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0"
              Margin="0,16,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="ProfileSelectedText"
                       Text="{loc:Localize Key=tweaks.profileEmpty}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="ProfileCloseButton"
                    Content="{loc:Localize Key=common.close}"
                    Click="ProfileCloseButton_Click"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="ProfileSaveButton"
                    Click="ProfileSaveButton_Click"
                    IsEnabled="False"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock Text="{loc:Localize Key=tweaks.saveProfile}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    x:Name="ProfileApplyButton"
                    Click="ProfileApplyButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock Text="{loc:Localize Key=common.apply}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
