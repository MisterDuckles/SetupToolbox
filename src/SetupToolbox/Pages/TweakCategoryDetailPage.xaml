<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SetupToolbox.Pages.TweakCategoryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Back naar de category-grid -->
        <Button Grid.Row="0"
                x:Name="BackButton"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8,6"
                Margin="0,0,0,4"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                <TextBlock Text="Terug naar categorieën"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </Button>

        <!-- Titel: icoon + categorie-naam -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,4,0,16"
                    VerticalAlignment="Center">
            <TextBlock x:Name="CategoryIcon" FontSize="28" VerticalAlignment="Center" />
            <TextBlock x:Name="CategoryTitle"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="ResultBar"
                 Grid.Row="2"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="True"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <Grid Grid.Row="3">
            <ScrollView VerticalScrollBarVisibility="Auto"
                        Padding="0,0,14,12"
                        ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
                <StackPanel x:Name="ContentContainer" Spacing="8" />
            </ScrollView>

            <Grid x:Name="LoadingOverlay"
                  Background="{ThemeResource SmokeFillColorDefaultBrush}"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing Width="40" Height="40" IsIndeterminate="True" />
                    <TextBlock x:Name="LoadingOverlayText"
                               Text="Wijzigingen toepassen..."
                               Style="{StaticResource BodyTextBlockStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Globale footer — identiek aan de landing. -->
        <Grid Grid.Row="4"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0"
              Margin="0,16,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="PendingCountText"
                       Text="Geen openstaande wijzigingen"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="DiscardButton"
                    Content="Discard"
                    IsEnabled="False"
                    Click="DiscardButton_Click"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="ApplyButton"
                    Click="ApplyButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock x:Name="ApplyButtonText" Text="Apply" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
