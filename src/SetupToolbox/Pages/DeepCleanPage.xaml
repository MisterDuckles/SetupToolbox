<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SetupToolbox.Pages.DeepCleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Localize Key=deepclean.title}"
                   Style="{StaticResource TitleTextBlockStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,0,8" />

        <InfoBar Grid.Row="1"
                 Severity="Informational"
                 Title="{loc:Localize Key=deepclean.header}"
                 Message="{loc:Localize Key=deepclean.intro.body}"
                 IsOpen="True"
                 IsClosable="True"
                 MaxWidth="720"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <!-- Resultaat-bar — vult zich na elke scan / delete met status. -->
        <InfoBar x:Name="CleanupResultBar"
                 Grid.Row="2"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="True"
                 MaxWidth="720"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <ScrollView Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,14,12">
            <StackPanel Spacing="12">
                <!-- Card 1: Windows caches scan -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE74D;"
                                  FontSize="22"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=deepclean.caches.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="15" />
                            <TextBlock Text="{loc:Localize Key=deepclean.caches.desc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="ScanCachesButton"
                                Click="ScanCachesButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=deepclean.caches.scan}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Card 2: Leftovers scan (folders + registry uninstall keys) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7B8;"
                                  FontSize="22"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{loc:Localize Key=deepclean.leftovers.title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="15" />
                            <TextBlock Text="{loc:Localize Key=deepclean.leftovers.desc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="ScanOrphanedButton"
                                Click="ScanOrphanedButton_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=deepclean.leftovers.scan}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ProgressRing x:Name="DeepCleanScanRing"
                              Width="32" Height="32"
                              IsIndeterminate="True"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed"
                              Margin="0,8,0,0" />

                <!-- Empty-state panel — netter dan een InfoBar als de scan
                     niets vond. Default Collapsed; pagina-code toggelt 'm
                     wanneer items.Count == 0. -->
                <Border x:Name="EmptyStatePanel"
                        Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="32,28"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE73E;"
                                  FontSize="38"
                                  HorizontalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="EmptyStateTitle"
                                   Text="{loc:Localize Key=deepclean.clean.title}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="EmptyStateDescription"
                                   Text="{loc:Localize Key=deepclean.clean.desc}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="480"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
