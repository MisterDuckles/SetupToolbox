<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SetupToolbox.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SetupToolbox.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <!-- Welcome-banner (v0.10.1) — dismissible via X (zet ShowWelcomeBanner
                 op false). Default Collapsed; code-behind toont 'm als de setting
                 aan staat. Collapsed i.p.v. alleen IsOpen=false zodat een gesloten
                 banner geen StackPanel-spacing boven de header reserveert. -->
            <InfoBar x:Name="WelcomeBanner"
                     IsOpen="False"
                     Visibility="Collapsed"
                     IsClosable="True"
                     Severity="Informational"
                     Title="{loc:Localize Key=apps.welcome.title}"
                     Message="{loc:Localize Key=apps.welcome.body}"
                     CloseButtonClick="WelcomeBanner_CloseButtonClick" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{loc:Localize Key=apps.title}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <AutoSuggestBox Grid.Column="1"
                                x:Name="SearchBox"
                                PlaceholderText="{loc:Localize Key=apps.search.placeholder}"
                                QueryIcon="Find"
                                Width="320"
                                VerticalAlignment="Center"
                                TextChanged="SearchBox_TextChanged" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="NoResultsText"
                   Text=""
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12"
                   Visibility="Collapsed" />

        <Grid Grid.Row="2">
            <!-- Loading state -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <TextBlock Text="{loc:Localize Key=apps.loading}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Error state -->
            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     Title="{loc:Localize Key=apps.loadFailed.title}"
                     Message="{loc:Localize Key=apps.loadFailed.body}"
                     IsOpen="False"
                     IsClosable="False"
                     VerticalAlignment="Top"
                     MaxWidth="720"
                     HorizontalAlignment="Left" />

            <!-- Category grid + winget search results — share one scroller so
                 the whole search result surface scrolls together. ScrollView
                 i.p.v. ScrollViewer (legacy) — moderne input handling werkt
                 met Parsec en Win11 input system. Padding-rechts geeft ademruimte
                 naast de scrollbar zodat kaarten niet tegen de rail aan plakken. -->
            <ScrollView x:Name="CategoryScroller"
                        Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto"
                        Padding="0,0,14,12"
                        ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
                <StackPanel Spacing="24">
                    <ItemsRepeater x:Name="CategoryList">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="260"
                                               MinItemHeight="150"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Button Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Click="CategoryCard_Click"
                                        Tag="{x:Bind Id}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="{x:Bind Icon}"
                                                   FontSize="32"
                                                   Margin="0,0,0,8"
                                                   HorizontalAlignment="Left" />

                                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <FontIcon Grid.Row="2"
                                                  Glyph="&#xE76C;"
                                                  FontSize="12"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Flat matching-apps sectie uit onze eigen apps.json — alleen
                         zichtbaar tijdens search. Zo hoeft user niet eerst een
                         categorie in te klikken om een specifieke app te vinden. -->
                    <StackPanel x:Name="CatalogResultsSection"
                                Visibility="Collapsed"
                                Spacing="12">
                        <TextBlock Text="{loc:Localize Key=apps.inCuratedList}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBlock x:Name="CatalogEmptyText"
                                   Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />

                        <ItemsRepeater x:Name="CatalogResultsList">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:App">
                                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          CornerRadius="4"
                                          Padding="16,12"
                                          Tag="{x:Bind}"
                                          Tapped="CatalogCard_Tapped"
                                          PointerEntered="AppCard_PointerEntered"
                                          PointerExited="AppCard_PointerExited">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{x:Bind IconImage}"
                                               Width="40" Height="40"
                                               Margin="0,0,14,0"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               ImageFailed="AppIcon_ImageFailed" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind Popular}">
                                                    <TextBlock Text="{loc:Localize Key=common.popular}"
                                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                                </Border>
                                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsInstalled, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="10"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Localize Key=common.installed}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind ManualDownloadVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE71B;"
                                                                  FontSize="10"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Localize Key=common.manualDownload}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Winget repository results — zichtbaar zodra user iets
                         typt in de search box. Laat apps zien die niet in onze
                         gecureerde apps.json staan. -->
                    <StackPanel x:Name="WingetSection"
                                Visibility="Collapsed"
                                Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Localize Key=apps.wingetResults}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <ProgressRing Grid.Column="1"
                                          x:Name="WingetSearchingRing"
                                          Width="18" Height="18"
                                          IsActive="True"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                        </Grid>

                        <TextBlock x:Name="WingetEmptyText"
                                   Text=""
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />

                        <ItemsRepeater x:Name="WingetResultsList">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:App">
                                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          CornerRadius="4"
                                          Padding="16,12"
                                          Tag="{x:Bind}"
                                          Tapped="WingetCard_Tapped"
                                          PointerEntered="AppCard_PointerEntered"
                                          PointerExited="AppCard_PointerExited">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind IsInstalled, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE73E;"
                                                                  FontSize="10"
                                                                  VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Localize Key=common.installed}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind WingetId}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  MinWidth="0"
                                                  IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </ScrollView>
        </Grid>

        <!-- Global selection footer — same totals as CategoryDetailPage so the
             user can install from the category overview without drilling in. -->
        <Grid Grid.Row="3"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0"
              Margin="0,16,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="SelectionCountText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="ClearSelectionButton"
                    Content="{loc:Localize Key=common.clearAll}"
                    IsEnabled="False"
                    Click="ClearSelectionButton_Click"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="InstallButton"
                    Content="{loc:Localize Key=common.installSelected}"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="InstallButton_Click"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
