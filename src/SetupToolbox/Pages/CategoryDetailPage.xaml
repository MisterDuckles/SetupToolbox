<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SetupToolbox.Pages.CategoryDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SetupToolbox.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Back button -->
        <Button Grid.Row="0"
                x:Name="BackButton"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8,6"
                Margin="0,0,0,4"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                <TextBlock Text="{loc:Localize Key=category.back}"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </Button>

        <!-- Title + filter mode + search + select all -->
        <Grid Grid.Row="1" Margin="0,4,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="CategoryTitle"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <!-- IsSelected="True" zou tijdens XAML-parse al een SelectionChanged
                 firen voordat SearchBox / GroupList / footer-elementen bestaan.
                 De _uiReady-guard in de handler vangt dat af zodat we niet
                 dubbel renderen. -->
            <ComboBox Grid.Column="1"
                      x:Name="FilterModeBox"
                      MinWidth="140"
                      VerticalAlignment="Center"
                      SelectionChanged="FilterModeBox_SelectionChanged">
                <ComboBoxItem Content="{loc:Localize Key=category.allApps}" IsSelected="True" />
                <ComboBoxItem Content="{loc:Localize Key=common.popular}" />
                <ComboBoxItem Content="{loc:Localize Key=common.installed}" />
            </ComboBox>
            <AutoSuggestBox Grid.Column="2"
                            x:Name="SearchBox"
                            PlaceholderText="{loc:Localize Key=category.filter.placeholder}"
                            QueryIcon="Find"
                            Width="260"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
            <Button Grid.Column="3"
                    x:Name="SelectAllButton"
                    Content="{loc:Localize Key=common.selectAll}"
                    Click="SelectAllButton_Click"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- No results state -->
        <TextBlock Grid.Row="2"
                   x:Name="NoResultsText"
                   Text=""
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   Visibility="Collapsed" />

        <!-- Apps gegroepeerd per subcategorie. ScrollView (nieuwe WinUI 3 control)
             i.p.v. ScrollViewer (legacy UWP-erfgenaam) — moderne input handling
             gebruikt het Microsoft.UI.Input system, waardoor Windows Settings
             en andere moderne apps probleemloos scrollen via Parsec. ScrollViewer
             gebruikt het oudere pointer-input-model dat Parsec niet altijd goed
             door-routeert. -->
        <ScrollView Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,14,0"
                    ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
            <ItemsRepeater x:Name="GroupList">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="20" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:SubcategoryGroup">
                        <StackPanel Spacing="8">
                            <!-- Sectie-header alleen tonen wanneer Name niet leeg is.
                                 Browsers/Communication/Gaming hebben geen subcats →
                                 één lege groep zonder header. -->
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       FontSize="16"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind HasName}" />

                            <ItemsRepeater ItemsSource="{x:Bind Apps}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:App">
                                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                              BorderThickness="1"
                                              CornerRadius="4"
                                              Padding="16,12"
                                              Tag="{x:Bind WingetId}"
                                              Tapped="AppCard_Tapped"
                                              PointerEntered="AppCard_PointerEntered"
                                              PointerExited="AppCard_PointerExited">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Bundled app icon (128x128 PNG, gerendered op 40x40).
                                                 ImageFailed → ontbrekend bestand verbergt de Image
                                                 zonder de layout te breken (PuTTY heeft bv. geen icon). -->
                                            <Image Grid.Column="0"
                                                   Source="{x:Bind IconImage}"
                                                   Width="40" Height="40"
                                                   Margin="0,0,14,0"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center"
                                                   ImageFailed="AppIcon_ImageFailed" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind Popular}">
                                                        <TextBlock Text="{loc:Localize Key=common.popular}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind IsInstalled, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE73E;"
                                                                      FontSize="10"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Text="{loc:Localize Key=common.installed}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind ManualDownloadVisibility}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE71B;"
                                                                      FontSize="10"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Text="{loc:Localize Key=common.manualDownload}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      MinWidth="0"
                                                      IsHitTestVisible="False" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollView>

        <!-- Footer with GLOBAL selection count (across all categories) -->
        <Grid Grid.Row="3"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0"
              Margin="0,16,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="SelectionCountText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="ClearSelectionButton"
                    Content="{loc:Localize Key=common.clearAll}"
                    IsEnabled="False"
                    Click="ClearSelectionButton_Click"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="InstallButton"
                    Content="{loc:Localize Key=common.installSelected}"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="InstallButton_Click"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
