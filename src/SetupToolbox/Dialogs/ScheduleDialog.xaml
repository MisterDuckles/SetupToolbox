<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SetupToolbox.Dialogs.ScheduleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{loc:Localize Key=dialog.schedule.title}"
    PrimaryButtonText="{loc:Localize Key=dialog.schedule.create}"
    CloseButtonText="{loc:Localize Key=common.cancel}"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DialogDefaultButtonStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16">
        <TextBlock Text="{loc:Localize Key=dialog.schedule.desc}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Spacing="8">
            <TextBlock Text="{loc:Localize Key=dialog.schedule.frequency}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButton x:Name="DailyRadio"
                         Content="{loc:Localize Key=dialog.schedule.daily}"
                         GroupName="ScheduleType"
                         IsChecked="True"
                         Checked="ScheduleRadio_Changed" />
            <RadioButton x:Name="WeeklyRadio"
                         Content="{loc:Localize Key=dialog.schedule.weekly}"
                         GroupName="ScheduleType"
                         Checked="ScheduleRadio_Changed" />
            <RadioButton x:Name="OnStartupRadio"
                         Content="{loc:Localize Key=dialog.schedule.logon}"
                         GroupName="ScheduleType"
                         Checked="ScheduleRadio_Changed" />
        </StackPanel>

        <StackPanel x:Name="TimePanel" Spacing="8">
            <TextBlock Text="{loc:Localize Key=dialog.schedule.time}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TimePicker x:Name="TimePickerCtrl"
                        ClockIdentifier="24HourClock"
                        HorizontalAlignment="Left"
                        MinuteIncrement="5" />
        </StackPanel>

        <InfoBar x:Name="ResultBar"
                 Severity="Informational"
                 IsOpen="False"
                 IsClosable="False" />
    </StackPanel>
</ContentDialog>
