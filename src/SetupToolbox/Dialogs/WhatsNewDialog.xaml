<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SetupToolbox.Dialogs.WhatsNewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    CornerRadius="8">

    <!-- Titel, knoptekst en alle labels worden in code gezet: de titel draagt het
         versienummer als parameter, en de rest hoort in dezelfde taal te staan op
         het moment dat de dialog gebouwd wordt. Een ContentDialog leeft kort, dus
         een taalwissel eronder vandaan bestaat hier niet. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="IntroText"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- MaxHeight en niet Height: een korte release-notes hoort geen halve lege
             dialog op te leveren, een lange moet kunnen scrollen. -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="360"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled">
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12">
                <TextBlock x:Name="NotesText"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </Border>
        </ScrollViewer>

        <HyperlinkButton Grid.Row="2"
                         x:Name="NotesLink"
                         Padding="0"
                         HorizontalAlignment="Left" />
    </Grid>
</ContentDialog>