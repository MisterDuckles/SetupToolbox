<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SetupToolbox.Dialogs.ConfigExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:SetupToolbox.Dialogs"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{loc:Localize Key=config.export.title}"
    PrimaryButtonText="{loc:Localize Key=common.export}"
    CloseButtonText="{loc:Localize Key=common.cancel}"
    DefaultButton="Primary"
    CornerRadius="8">

    <ContentDialog.Resources>
        <!-- Zonder Stretch krimpt de rij tot de breedte van zijn inhoud en staat
             de "Installed"-badge midden in de dialog in plaats van rechts. -->
        <Style x:Key="ConfigExportRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </ContentDialog.Resources>

    <Grid MinWidth="520" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{loc:Localize Key=config.export.intro}" />

        <!-- Wat er buiten de app-lijst om sowieso mee gaat. Tweaks en voorkeuren
             zijn niet per stuk uit te vinken bij het exporteren: die keuze hoort
             bij het IMPORTEREN, want daar weet je pas op welke machine je landt. -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TweakSummaryText"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="SettingsSummaryText"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            QueryIcon="Find"
                            PlaceholderText="{loc:Localize Key=config.export.searchPlaceholder}"
                            TextChanged="SearchBox_TextChanged" />

            <Button Grid.Column="1"
                    Content="{loc:Localize Key=common.selectAll}"
                    Click="SelectAll_Click" />
            <Button Grid.Column="2"
                    Content="{loc:Localize Key=common.deselectAll}"
                    Click="DeselectAll_Click" />
        </Grid>

        <ListView x:Name="AppList"
                  Grid.Row="3"
                  Height="280"
                  SelectionMode="None"
                  ItemContainerStyle="{StaticResource ConfigExportRowStyle}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:ConfigExportAppRow">
                    <Grid ColumnSpacing="10" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  MinWidth="0"
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind WingetId}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Border Visibility="{x:Bind OutsideCatalogBadgeVisibility}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{loc:Localize Key=config.export.outsideCatalog}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border Visibility="{x:Bind InstalledBadgeVisibility}"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{loc:Localize Key=common.installed}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3"
                   x:Name="NoMatchText"
                   Visibility="Collapsed"
                   VerticalAlignment="Top"
                   Margin="8,8,0,0"
                   Text="{loc:Localize Key=config.export.noMatch}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock Grid.Row="4"
                   x:Name="CountText"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</ContentDialog>
