<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SetupToolbox.Dialogs.UninstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dialogs="using:SetupToolbox.Dialogs"
    mc:Ignorable="d"
    Title="{loc:Localize Key=dialog.uninstall.title}"
    PrimaryButtonText="{loc:Localize Key=common.close}"
    IsPrimaryButtonEnabled="False"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonStyle="{StaticResource DialogPrimaryButtonStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProgressHeader"
                   Text="{loc:Localize Key=common.preparing}"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <ItemsControl x:Name="AppItemList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:UninstallItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,0,0,8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <!-- Status icon: spinning ring while pending/running, check/error op terminal state -->
                                <Grid Grid.Column="0"
                                      Width="20" Height="20"
                                      VerticalAlignment="Center">
                                    <ProgressRing Width="20" Height="20"
                                                  IsActive="True"
                                                  Visibility="{x:Bind RingVisibility, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE73E;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              FontSize="18"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xEA39;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              FontSize="18"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                              Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="15" />

                                    <ProgressBar HorizontalAlignment="Stretch"
                                                 IsIndeterminate="True"
                                                 ShowPaused="False"
                                                 ShowError="False"
                                                 Visibility="{x:Bind BarVisibility, Mode=OneWay}" />

                                    <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind MessageVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind StateLabel, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{x:Bind StateLabelBrush, Mode=OneWay}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
