<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SetupToolbox.Dialogs.BackupPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{loc:Localize Key=dialog.backup.title}"
    PrimaryButtonText="{loc:Localize Key=dialog.backup.withBackup}"
    SecondaryButtonText="{loc:Localize Key=dialog.backup.withoutBackup}"
    CloseButtonText="{loc:Localize Key=common.cancel}"
    DefaultButton="Primary"
    CornerRadius="8">

    <StackPanel Spacing="14" MinWidth="420">
        <!-- Drie Runs in plaats van een Text-attribuut, want de knopnaam midden in
             de zin hoort vet te blijven: het is een letterlijke knop. Die naam komt
             uit DEZELFDE key als de knop zelf (tweaks.restoreSnapshot), zodat de
             twee niet uit elkaar kunnen lopen bij een hernoeming.

             Deze alinea stond tot v1.2.9.5 als inline XAML-INHOUD hardcoded in het
             Nederlands, en geen enkele scanner-pass zag 'm: pass 1 keek alleen naar
             tekst-ATTRIBUTEN. In de Engelse UI stond hier dus gewoon Nederlands, bij
             elke Tweaks-Apply met BackupBeforeApply = Ask. Pass 1b in
             scan-untranslated.py is in dezelfde patch toegevoegd en ziet deze vorm
             nu wel. -->
        <TextBlock TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run Text="{loc:Localize Key=dialog.backup.explain.before}" />
            <Run FontWeight="SemiBold" Text="{loc:Localize Key=tweaks.restoreSnapshot}" />
            <Run Text="{loc:Localize Key=dialog.backup.explain.after}" />
        </TextBlock>

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Localize Key=dialog.backup.nameLabel}"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="NameBox"
                     PlaceholderText="{loc:Localize Key=dialog.backup.namePlaceholder}"
                     MaxLength="80" />
        </StackPanel>

        <CheckBox x:Name="DontAskCheckBox"
                  Content="{loc:Localize Key=dialog.backup.dontAsk}" />

        <InfoBar Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Title="{loc:Localize Key=dialog.backup.safetyHeader}"
                 Message="{loc:Localize Key=dialog.backup.safetyBody}" />
    </StackPanel>
</ContentDialog>
