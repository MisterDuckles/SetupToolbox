<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="SetupToolbox.Dialogs.BackupPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:SetupToolbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{loc:Localize Key=dialog.backup.title}"
    PrimaryButtonText="{loc:Localize Key=dialog.backup.withBackup}"
    SecondaryButtonText="{loc:Localize Key=dialog.backup.withoutBackup}"
    CloseButtonText="{loc:Localize Key=common.cancel}"
    DefaultButton="Primary"
    CornerRadius="8">

    <StackPanel Spacing="14" MinWidth="420">
        <TextBlock TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            We kunnen een snapshot maken van de huidige registry-waardes voor de tweaks die je zo gaat applyen. Als er later iets niet bevalt, klik je op <Run FontWeight="SemiBold">Vorige staat herstellen</Run> bovenaan de Tweaks tab om alles terug te zetten zoals 't was.
        </TextBlock>

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Localize Key=dialog.backup.nameLabel}"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBox x:Name="NameBox"
                     PlaceholderText="{loc:Localize Key=dialog.backup.namePlaceholder}"
                     MaxLength="80" />
        </StackPanel>

        <CheckBox x:Name="DontAskCheckBox"
                  Content="{loc:Localize Key=dialog.backup.dontAsk}" />

        <InfoBar Severity="Informational"
                 IsOpen="True"
                 IsClosable="False"
                 Title="{loc:Localize Key=dialog.backup.safetyHeader}"
                 Message="Snapshots worden lokaal opgeslagen (max 20 stuks, oudste wordt automatisch verwijderd). Je kan alle snapshots later inzien via Settings." />
    </StackPanel>
</ContentDialog>
