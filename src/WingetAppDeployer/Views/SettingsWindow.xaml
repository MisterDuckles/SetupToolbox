<Window x:Class="WingetAppDeployer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundColor}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="⚙️ Settings"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryColor}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Appearance -->
                <Border Background="{DynamicResource SurfaceColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🎨 Appearance"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Theme:" Margin="0,0,0,5"
                                   Foreground="{DynamicResource TextPrimaryColor}"/>
                        <ComboBox x:Name="ThemeComboBox"
                                  Margin="0,0,0,15"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Google" Tag="Google"/>
                            <ComboBoxItem Content="Windows 11" Tag="Windows"/>
                            <ComboBoxItem Content="Sunset" Tag="Sunset"/>
                            <ComboBoxItem Content="Ocean Breeze" Tag="OceanBreeze"/>
                            <ComboBoxItem Content="Aurora" Tag="Aurora"/>
                        </ComboBox>

                        <CheckBox x:Name="DarkModeCheckBox"
                                  Content="Dark Mode"
                                  Foreground="{DynamicResource TextPrimaryColor}"
                                  Margin="0,5,0,0"
                                  Checked="DarkModeCheckBox_Changed"
                                  Unchecked="DarkModeCheckBox_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Background="{DynamicResource SurfaceColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🔄 Updates"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,0,0,15"/>

                        <CheckBox x:Name="CheckUpdatesOnStartupCheckBox"
                                  Content="Check for app updates on startup"
                                  Foreground="{DynamicResource TextPrimaryColor}"
                                  Margin="0,0,0,10"/>

                        <Button Content="Manage Auto-Update Schedule"
                                Width="200"
                                HorizontalAlignment="Left"
                                Click="ManageScheduleButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Background="{DynamicResource SurfaceColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="📋 General"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,0,0,15"/>

                        <CheckBox x:Name="ShowWelcomeCheckBox"
                                  Content="Show welcome message on startup"
                                  Foreground="{DynamicResource TextPrimaryColor}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="About"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,15,0,5"/>
                        <TextBlock Text="WingetAppDeployer v1.0.2"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryColor}"/>
                        <TextBlock Text="A modern app installer for Windows using Winget"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="Save"
                    Width="100"
                    Height="40"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
