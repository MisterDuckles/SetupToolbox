<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Sunset Dark Theme - Deep warm tones with rich orange and brown accents -->

    <!-- Colors -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#FF8C5A"/>
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#FF6B35"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#4A2A1E"/>
    <SolidColorBrush x:Key="AccentColor" Color="#D4A574"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#1A0F0A"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#2D1F18"/>
    <SolidColorBrush x:Key="CardHoverColor" Color="#3D2A1E"/>
    <SolidColorBrush x:Key="FooterBackgroundColor" Color="#2A1E16"/>
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#FFF0E5"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#C4A898"/>
    <SolidColorBrush x:Key="BorderColor" Color="#4A3628"/>
    <SolidColorBrush x:Key="CategoryCardBg" Color="#4A3225"/>
    <SolidColorBrush x:Key="CategoryCardBorder" Color="#5A3F2E"/>
    <SolidColorBrush x:Key="SearchBoxBackgroundColor" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SearchBoxBorderColor" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextColor" Color="White"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#EF5350"/>

    <!-- Header Gradient -->
    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#4A1A0A" Offset="0"/>
        <GradientStop Color="#2D0F06" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card properties -->
    <sys:Double x:Key="CardCornerRadius">14</sys:Double>
    <sys:Double x:Key="CardShadowDepth">3</sys:Double>
    <sys:Double x:Key="CardShadowBlur">20</sys:Double>
    <sys:Double x:Key="CardShadowOpacity">0.25</sys:Double>
    <sys:Double x:Key="CategoryCornerRadius">14</sys:Double>

    <!-- Flat Button (on colored header - white text) -->
    <Style x:Key="MaterialDesignFlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#20FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Raised Button (install button) -->
    <Style x:Key="MaterialDesignRaisedButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="#1A0F0A"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.4" Color="#000000"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#4A3628"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="#8B6F5E"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Select All Button -->
    <Style x:Key="SelectAllButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="#1A0F0A"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Back Button -->
    <Style x:Key="BackButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Progress Bar -->
    <Style x:Key="MaterialDesignCircularProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Ellipse Stroke="#4A3628" StrokeThickness="3" Margin="5"/>
                        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="3" Margin="5"
                                 StrokeDashArray="2 4" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinTransform" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinTransform"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>