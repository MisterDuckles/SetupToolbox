<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Google Dark Theme - Dark variant of Google's Material Design language -->

    <!-- Colors -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#8AB4F8"/>
    <SolidColorBrush x:Key="PrimaryDarkColor" Color="#4285F4"/>
    <SolidColorBrush x:Key="PrimaryLightColor" Color="#394457"/>
    <SolidColorBrush x:Key="AccentColor" Color="#81C995"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#202124"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#303134"/>
    <SolidColorBrush x:Key="CardHoverColor" Color="#3C4043"/>
    <SolidColorBrush x:Key="FooterBackgroundColor" Color="#2D2E32"/>
    <SolidColorBrush x:Key="TextPrimaryColor" Color="#E8EAED"/>
    <SolidColorBrush x:Key="TextSecondaryColor" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="BorderColor" Color="#5F6368"/>
    <SolidColorBrush x:Key="CategoryCardBg" Color="#3C4043"/>
    <SolidColorBrush x:Key="CategoryCardBorder" Color="#4A5568"/>
    <SolidColorBrush x:Key="SearchBoxBackgroundColor" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SearchBoxBorderColor" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="HeaderTextColor" Color="White"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#EF5350"/>

    <!-- Header Gradient -->
    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#3C4045" Offset="0"/>
        <GradientStop Color="#2D2E32" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card properties -->
    <sys:Double x:Key="CardCornerRadius">12</sys:Double>
    <sys:Double x:Key="CardShadowDepth">3</sys:Double>
    <sys:Double x:Key="CardShadowBlur">20</sys:Double>
    <sys:Double x:Key="CardShadowOpacity">0.20</sys:Double>
    <sys:Double x:Key="CategoryCornerRadius">12</sys:Double>

    <!-- Flat Button (on colored header - white text) -->
    <Style x:Key="MaterialDesignFlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#20FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Raised Button (install button) -->
    <Style x:Key="MaterialDesignRaisedButton" TargetType="Button">
        <Setter Property="Background" Value="#8AB4F8"/>
        <Setter Property="Foreground" Value="#202124"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.3" Color="#000000"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4285F4"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#3C4043"/>
                <Setter Property="Foreground" Value="#5F6368"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Select All Button -->
    <Style x:Key="SelectAllButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#394457"/>
        <Setter Property="Foreground" Value="#8AB4F8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#8AB4F8"/>
                <Setter Property="Foreground" Value="#202124"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Back Button -->
    <Style x:Key="BackButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8AB4F8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#394457"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Progress Bar -->
    <Style x:Key="MaterialDesignCircularProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Ellipse Stroke="#5F6368" StrokeThickness="3" Margin="5"/>
                        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="3" Margin="5"
                                 StrokeDashArray="2 4" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinTransform" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinTransform"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>