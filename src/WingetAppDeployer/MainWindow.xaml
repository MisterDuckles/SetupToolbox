<Window x:Class="WingetAppDeployer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="WingetAppDeployer"
        Height="700"
        Width="1000"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header with gradient -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.15" Color="#000000" Direction="270"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🪟" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="WingetAppDeployer" FontSize="22" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextColor}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SearchBoxBackgroundColor}"
                            BorderBrush="{DynamicResource SearchBoxBorderColor}"
                            CornerRadius="6" Margin="0,0,12,0" BorderThickness="1">
                        <TextBox Width="220"
                                 x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged"
                                 Padding="10,7"
                                 FontSize="13"
                                 Foreground="{DynamicResource HeaderTextColor}"
                                 FocusVisualStyle="{x:Null}"
                                 OverridesDefaultStyle="True">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  Margin="2"/>
                                </ControlTemplate>
                            </TextBox.Template>
                            <TextBox.CaretBrush>
                                <DynamicResourceExtension ResourceKey="HeaderTextColor"/>
                            </TextBox.CaretBrush>
                        </TextBox>
                    </Border>
                    <Button Content="⚙️" FontSize="18" Width="44" Height="44"
                            Padding="0"
                            Style="{DynamicResource MaterialDesignFlatButton}"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with smooth scrolling -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
            <StackPanel x:Name="ContentPanel" Margin="24,20,24,20">

                <!-- Welcome banner -->
                <Border x:Name="WelcomeBanner"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20"
                        Visibility="Collapsed"
                        Background="{DynamicResource HeaderBackground}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="👋 Welcome to WingetAppDeployer!"
                                     FontSize="20" FontWeight="Bold" Foreground="{DynamicResource HeaderTextColor}"/>
                            <TextBlock Text="Quickly install your favorite applications using Winget. Browse categories below to get started."
                                     FontSize="14" Foreground="{DynamicResource HeaderTextColor}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="✕"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource HeaderTextColor}"
                                Click="CloseWelcome_Click"/>
                    </Grid>
                </Border>

                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80">
                    <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
                                 Value="0" IsIndeterminate="True" Width="60" Height="60"/>
                    <TextBlock Text="Loading apps..."
                               FontSize="16" HorizontalAlignment="Center" Margin="0,15,0,0"
                               Foreground="{DynamicResource TextSecondaryColor}"/>
                </StackPanel>

                <!-- Category Grid (main view) -->
                <WrapPanel x:Name="CategoryGridPanel" Visibility="Collapsed"
                           HorizontalAlignment="Center"/>

                <!-- App List (after clicking a category) -->
                <StackPanel x:Name="AppListPanel" Visibility="Collapsed">
                    <!-- Back button + category header + apps rendered dynamically -->
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="-2" BlurRadius="6" Opacity="0.06" Color="#000000" Direction="90"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionCountText"
                               Text="0 apps selected"
                               FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryColor}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="InstallButton"
                            Content="Install Selected Apps"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Height="45" Padding="30,0" FontSize="14"
                            Click="InstallButton_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
