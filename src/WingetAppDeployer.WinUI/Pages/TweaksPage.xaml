<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Tweaks"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <!-- Vorige staat herstellen — zet de registry-waardes terug naar
                 de laatst opgeslagen snapshot. Alleen zichtbaar als er
                 minstens 1 snapshot bestaat. -->
            <Button Grid.Column="1"
                    x:Name="RestoreButton"
                    Click="RestoreButton_Click"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Zet de registry-waardes voor alle eerder getoggle-de tweaks terug naar hoe ze waren vóór je laatste Apply.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                    <TextBlock Text="Vorige staat herstellen" />
                </StackPanel>
            </Button>

            <!-- Discard pending changes — alleen zichtbaar als er pending changes zijn. -->
            <Button Grid.Column="2"
                    x:Name="DiscardButton"
                    Click="DiscardButton_Click"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Content="Discard" />

            <!-- Apply alle pending changes in 1 batch + één explorer-restart aan het einde. -->
            <Button Grid.Column="3"
                    x:Name="ApplyButton"
                    Click="ApplyButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    <TextBlock x:Name="ApplyButtonText" Text="Apply" />
                </StackPanel>
            </Button>

            <!-- Manual escape — kill explorer.exe los van Apply, voor zeldzame edge cases. -->
            <Button Grid.Column="4"
                    x:Name="RestartExplorerButton"
                    Click="RestartExplorerButton_Click"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Restart de Windows shell handmatig — gebruik dit als een tweak na Apply nog niet zichtbaar is.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Restart Explorer" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1"
                 Severity="Informational"
                 Title="Stage your changes, apply in batch"
                 Message="Vink wat je wil aan/uit en klik dan 'Apply' bovenaan. Onze app schrijft alles in 1 keer en herstart de shell — voorspelbaar, geen race-condities. Tweaks die direct effect hebben (file extensions / hidden files) updaten zonder restart."
                 IsOpen="True"
                 IsClosable="True"
                 MaxWidth="780"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <!-- Resultaat-bar voor apply feedback. -->
        <InfoBar x:Name="ResultBar"
                 Grid.Row="2"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="True"
                 MaxWidth="780"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <ScrollView Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,14,12"
                    ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
            <StackPanel x:Name="CategoriesContainer" Spacing="20" />
        </ScrollView>

        <!-- Loading-overlay tijdens initial state-detection en tijdens Apply-batch. -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="Visible">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing Width="40" Height="40" IsIndeterminate="True" />
                <TextBlock x:Name="LoadingOverlayText"
                           Text="Reading Windows state..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
