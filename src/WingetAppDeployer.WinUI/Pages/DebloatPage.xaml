<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.DebloatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WingetAppDeployer_WinUI.Models"
    xmlns:helpers="using:WingetAppDeployer_WinUI.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Card-template gedeeld tussen Microsoft + OEM bloatware secties. -->
        <DataTemplate x:Key="BloatwareCardTemplate" x:DataType="models:BloatwareItem">
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="16,12"
                  Tag="{x:Bind}"
                  Tapped="BloatwareCard_Tapped"
                  PointerEntered="AppCard_PointerEntered"
                  PointerExited="AppCard_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind DisplayName}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Category}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Description}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Visibility="{x:Bind InstalledVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;"
                                  FontSize="10"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Installed"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <CheckBox Grid.Column="2"
                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MinWidth="0"
                          Margin="12,0,0,0"
                          IsHitTestVisible="False" />
            </Grid>
        </DataTemplate>

        <!-- Card-template voor de unified "All installed apps" sectie. Toont
             source-badge per card; voor catalog-source gebruikt de bestaande
             icon-bundle, voor Store/Other geen icon (out-of-scope voor nu). -->
        <DataTemplate x:Key="InstalledAppCardTemplate" x:DataType="models:InstalledAppEntry">
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="16,12"
                  Tag="{x:Bind}"
                  Tapped="InstalledAppCard_Tapped"
                  PointerEntered="AppCard_PointerEntered"
                  PointerExited="AppCard_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{x:Bind IconImage}"
                       Width="40" Height="40"
                       Margin="0,0,14,0"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       Visibility="{x:Bind IconVisibility}"
                       ImageFailed="AppIcon_ImageFailed" />

                <FontIcon Grid.Column="0"
                          Glyph="&#xE7C3;"
                          FontSize="22"
                          Width="40" Height="40"
                          Margin="0,0,14,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Visibility="{x:Bind GenericIconVisibility}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind DisplayName}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   FontSize="15"
                                   VerticalAlignment="Center" />
                        <Border Background="{x:Bind SourceBadgeBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind SourceTooltip}">
                            <TextBlock Text="{x:Bind SourceBadgeText}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Border>
                        <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind SystemBadgeVisibility}"
                                ToolTipService.ToolTip="Windows system component — uninstalling can break OS functionality">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="10"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="System"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Subtitle}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <CheckBox Grid.Column="2"
                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MinWidth="0"
                          IsHitTestVisible="False" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="36,24,36,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Debloat — Apps"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1"
                 Severity="Informational"
                 Title="Apps debloat"
                 Message="Verwijder geïnstalleerde apps — Microsoft pre-install bloat, OEM bundleware, en alles uit deze catalog / Store / Web. Voor system-wide cache- en orphan-folder cleanup kies je &quot;Deep clean&quot; in de sidebar. Na een uninstall scant de app automatisch naar leftovers."
                 IsOpen="True"
                 IsClosable="True"
                 MaxWidth="720"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,8" />

        <!-- Scan-feedback bar — toont de uitkomst van de v0.8.5 leftover-scan
             ná een uninstall. Default verborgen; vult zich met "X items found"
             of "no leftovers found" zodat user weet dat de scan gelopen heeft. -->
        <InfoBar x:Name="CleanupResultBar"
                 Grid.Row="2"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="True"
                 MaxWidth="720"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <ScrollView Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,14,12"
                    ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
            <StackPanel Spacing="20">

                <!-- ================================================
                     SECTIE 1: Microsoft bloatware (curated quick-actions)
                     Inklapbaar via Expander zodat user snel naar de All apps
                     sectie kan zonder eerst door alle Microsoft items te scrollen.
                     ================================================ -->
                <Expander x:Name="MicrosoftExpander"
                          IsExpanded="False"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="8" Padding="0,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <TextBlock Text="Microsoft bloatware"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="BloatwareCountText"
                                               Text=""
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock x:Name="BloatwareSubtext"
                                           Text="Pre-installed Microsoft apps en system bloat. Acties via de balk onderaan."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="BloatwareSelectAllButton"
                                    Click="BloatwareSelectAllButton_Click"
                                    IsEnabled="False"
                                    VerticalAlignment="Center"
                                    Content="Select all" />
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="0,4,0,0" Spacing="8">
                        <AutoSuggestBox x:Name="BloatwareSearchBox"
                                        PlaceholderText="Search Microsoft bloatware"
                                        QueryIcon="Find"
                                        TextChanged="BloatwareSearchBox_TextChanged" />

                        <Grid>
                            <ProgressRing x:Name="BloatwareLoadingRing"
                                          Width="32" Height="32"
                                          IsIndeterminate="True"
                                          HorizontalAlignment="Center"
                                          Visibility="Collapsed" />

                            <TextBlock x:Name="BloatwareEmptyText"
                                       Text="Geen bekende Microsoft bloatware gedetecteerd op dit systeem."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"
                                       Margin="0,12,0,0" />

                            <ItemsRepeater x:Name="BloatwareList"
                                           ItemTemplate="{StaticResource BloatwareCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- ================================================
                     SECTIE 2: OEM bloatware (HP / Dell / Lenovo / etc.)
                     ================================================ -->
                <Expander x:Name="OemSection"
                          IsExpanded="True"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="8" Padding="0,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <TextBlock Text="OEM bloatware"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="OemCountText"
                                               Text=""
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="Bundleware van je hardware-fabrikant (HP / Dell / Lenovo / ASUS / Acer / MSI). Acties via de balk onderaan."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="OemSelectAllButton"
                                    Click="OemSelectAllButton_Click"
                                    IsEnabled="False"
                                    VerticalAlignment="Center"
                                    Content="Select all" />
                        </Grid>
                    </Expander.Header>

                    <ItemsRepeater x:Name="OemList"
                                   ItemTemplate="{StaticResource BloatwareCardTemplate}"
                                   Margin="0,4,0,0">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Expander>

                <!-- ================================================
                     SECTIE 3: All installed apps (unified)
                     Vervangt de v0.8.1 catalog-only sectie. Toont apps uit
                     álle bronnen (catalog / Store / registry installs) met
                     filter ComboBox en search. Catalog-uninstalls gaan direct
                     via winget zonder UAC; Store/Other in een gecombineerde
                     elevated PS-batch (één UAC voor de hele admin-required
                     subset).
                     ================================================ -->
                <Expander x:Name="InstalledExpander"
                          IsExpanded="True"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <Grid ColumnSpacing="8" Padding="0,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <TextBlock Text="All installed apps"
                                               Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="InstalledCountText"
                                               Text=""
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="Alles op de PC: apps uit deze catalogus, Microsoft Store / AppX packages, en alles uit de Windows registry uninstall keys (MSI/EXE installs). Uninstall via de balk onderaan."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="InstalledSelectAllButton"
                                    Click="InstalledSelectAllButton_Click"
                                    IsEnabled="False"
                                    VerticalAlignment="Center"
                                    Content="Select all" />
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="0,4,0,0" Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox Grid.Column="0"
                                            x:Name="InstalledSearchBox"
                                            PlaceholderText="Search installed apps"
                                            QueryIcon="Find"
                                            TextChanged="InstalledSearchBox_TextChanged" />
                            <ComboBox Grid.Column="1"
                                      x:Name="InstalledFilterBox"
                                      SelectionChanged="InstalledFilterBox_SelectionChanged"
                                      MinWidth="140">
                                <ComboBoxItem Content="All sources" IsSelected="True" />
                                <ComboBoxItem Content="Winget" />
                                <ComboBoxItem Content="Store" />
                                <ComboBoxItem Content="Web" />
                                <ComboBoxItem Content="System" />
                            </ComboBox>
                            <CheckBox Grid.Column="2"
                                      x:Name="ShowSystemCheckbox"
                                      Content="Show system components"
                                      ToolTipService.ToolTip="Include Windows system AppX packages (AAD.BrokerPlugin, BioEnrollment, etc.) — niet veilig om te uninstallen"
                                      Checked="ShowSystemCheckbox_Toggled"
                                      Unchecked="ShowSystemCheckbox_Toggled"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Grid>
                            <ProgressRing x:Name="InstalledLoadingRing"
                                          Width="32" Height="32"
                                          IsIndeterminate="True"
                                          HorizontalAlignment="Center"
                                          Visibility="Collapsed" />

                            <TextBlock x:Name="InstalledEmptyText"
                                       Text=""
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"
                                       Margin="0,12,0,0" />

                            <ItemsRepeater x:Name="InstalledList"
                                           ItemTemplate="{StaticResource InstalledAppCardTemplate}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </Grid>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollView>

        <!-- Sticky bottom footer voor de All-apps actie. Altijd zichtbaar
             onder aan de pagina zodat user niet hoeft te scrollen om te
             selecteren / uninstallen. Toont count zodra er iets geselecteerd
             is (anders blijft de count-tekst leeg en zien we een dunne strip
             met enkel de knoppen). Border-top scheidt 'm visueel van de
             scrollende content erboven. -->
        <Border Grid.Row="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,14,0"
                Margin="0,4,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="InstalledSelectionCountText"
                           Text="Nothing selected"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        x:Name="InstalledUninstallButton"
                        Click="InstalledUninstallButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Content="Uninstall selected" />
            </Grid>
        </Border>
    </Grid>
</Page>
