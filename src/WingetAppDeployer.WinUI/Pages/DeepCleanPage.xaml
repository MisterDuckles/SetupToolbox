<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.DeepCleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Debloat — Deep clean"
                   Style="{StaticResource TitleTextBlockStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,0,8" />

        <InfoBar Grid.Row="1"
                 Severity="Informational"
                 Title="System-wide cleanup"
                 Message="Maakt schijfruimte vrij door Windows caches en orphan-folders op te ruimen — los van een specifieke uninstall. Altijd preview vóór delete: niets wordt verwijderd zonder bevestiging."
                 IsOpen="True"
                 IsClosable="True"
                 MaxWidth="720"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <!-- Resultaat-bar — vult zich na elke scan / delete met status. -->
        <InfoBar x:Name="CleanupResultBar"
                 Grid.Row="2"
                 Severity="Success"
                 IsOpen="False"
                 IsClosable="True"
                 MaxWidth="720"
                 HorizontalAlignment="Left"
                 Margin="0,0,0,12" />

        <ScrollView Grid.Row="3"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,14,12">
            <StackPanel Spacing="12">
                <!-- Card 1: Windows caches scan -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE74D;"
                                  FontSize="22"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Windows caches"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="15" />
                            <TextBlock Text="Temp folders, Update cache, Recycle Bin, Prefetch, Windows.old, en browser caches (Edge / Chrome / Firefox / Brave). Veilige items default checked, caution-items default uit."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="ScanCachesButton"
                                Click="ScanCachesButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Scan caches" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Card 2: Leftovers scan (folders + registry uninstall keys) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7B8;"
                                  FontSize="22"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Leftovers (folders + registry)"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="15" />
                            <TextBlock Text="Scan Program Files / AppData voor folders zonder bijbehorende installed app, PLUS uninstall registry-keys waarvan alle pad-velden dood zijn. Bundle-by-name in de preview groept registry+folder van dezelfde app automatisch. Conservatief — alle items staan default uit."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="ScanOrphanedButton"
                                Click="ScanOrphanedButton_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Scan leftovers" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ProgressRing x:Name="DeepCleanScanRing"
                              Width="32" Height="32"
                              IsIndeterminate="True"
                              HorizontalAlignment="Center"
                              Visibility="Collapsed"
                              Margin="0,8,0,0" />
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
