<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="36,24,36,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Apps"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Sandbox demo — this is where the category grid and app list will live. For now it shows the Fluent control demo from v0.1.0."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,8,0,0">
                <SymbolIcon Symbol="AllApps" />
                <TextBlock Text="SymbolIcon rendering"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ToggleSwitch Header="Native toggle switch" IsOn="True" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Accept" />
                        <TextBlock Text="Primary Fluent button" />
                    </StackPanel>
                </Button>
                <Button>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock Text="Default button" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <InfoBar Severity="Informational"
                     Title="Category grid coming in v0.3.0"
                     Message="Next step is porting the category list + app list + install flow from the WPF app into this native WinUI 3 shell."
                     IsOpen="True"
                     IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
