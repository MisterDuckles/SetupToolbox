<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WingetAppDeployer_WinUI.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Apps"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <!-- Loading state -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <TextBlock Text="Loading categories..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Error state -->
            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     Title="Could not load categories"
                     Message="Check your internet connection and try again."
                     IsOpen="False"
                     IsClosable="False"
                     VerticalAlignment="Top"
                     MaxWidth="720"
                     HorizontalAlignment="Left" />

            <!-- Category grid (WinUI 3 Gallery style boxes) -->
            <ScrollViewer x:Name="CategoryScroller"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="CategoryList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="260"
                                           MinItemHeight="150"
                                           MinRowSpacing="12"
                                           MinColumnSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <Button Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="CategoryCard_Click"
                                    Tag="{x:Bind Id}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{x:Bind Icon}"
                                               FontSize="32"
                                               Margin="0,0,0,8"
                                               HorizontalAlignment="Left" />

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <FontIcon Grid.Row="2"
                                              Glyph="&#xE76C;"
                                              FontSize="12"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
