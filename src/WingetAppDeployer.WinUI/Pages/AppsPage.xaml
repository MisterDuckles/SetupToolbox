<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WingetAppDeployer_WinUI.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Apps"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <AutoSuggestBox Grid.Column="1"
                            x:Name="SearchBox"
                            PlaceholderText="Search apps or categories"
                            QueryIcon="Find"
                            Width="320"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="NoResultsText"
                   Text=""
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12"
                   Visibility="Collapsed" />

        <Grid Grid.Row="2">
            <!-- Loading state -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <TextBlock Text="Loading categories..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Error state -->
            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     Title="Could not load categories"
                     Message="Check your internet connection and try again."
                     IsOpen="False"
                     IsClosable="False"
                     VerticalAlignment="Top"
                     MaxWidth="720"
                     HorizontalAlignment="Left" />

            <!-- Category grid (WinUI 3 Gallery style boxes) -->
            <ScrollViewer x:Name="CategoryScroller"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,12">
                <ItemsRepeater x:Name="CategoryList">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="260"
                                           MinItemHeight="150"
                                           MinRowSpacing="12"
                                           MinColumnSpacing="12"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <Button Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="CategoryCard_Click"
                                    Tag="{x:Bind Id}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{x:Bind Icon}"
                                               FontSize="32"
                                               Margin="0,0,0,8"
                                               HorizontalAlignment="Left" />

                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <FontIcon Grid.Row="2"
                                              Glyph="&#xE76C;"
                                              FontSize="12"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <!-- Global selection footer — same totals as CategoryDetailPage so the
             user can install from the category overview without drilling in. -->
        <Grid Grid.Row="3"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="0,12,0,0"
              Margin="0,16,0,0"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="SelectionCountText"
                       Text="0 apps selected"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    x:Name="ClearSelectionButton"
                    Content="Clear all"
                    IsEnabled="False"
                    Click="ClearSelectionButton_Click"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    x:Name="InstallButton"
                    Content="Install selected apps"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="False"
                    Click="InstallButton_Click"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
