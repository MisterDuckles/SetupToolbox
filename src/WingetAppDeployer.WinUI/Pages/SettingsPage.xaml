<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollView VerticalScrollBarVisibility="Auto"
                ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
        <Grid Padding="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Settings"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,20" />

            <TextBlock Grid.Row="1"
                       Text="Auto-updates"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <!-- Auto-update schedule card -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE823;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Scheduled auto-updates"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ScheduleStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Checking status..." />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="DisableButton"
                                Click="DisableButton_Click"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Disable" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScheduleButton"
                                Click="ScheduleButton_Click"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="14" />
                                <TextBlock x:Name="ScheduleButtonText" Text="Set up" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="Installation"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Manual download fallback toggle -->
            <Border Grid.Row="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE71B;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Open vendor download pages"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="When installing apps that aren't on winget (badged 'Manual download'), open the vendor's download page in your default browser. Disable to skip these apps during install." />
                    </StackPanel>

                    <ToggleSwitch x:Name="FallbackToggle"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="FallbackToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Parallel installs toggle -->
            <Border Grid.Row="5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,8,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE9F5;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Run installs in parallel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Install up to 2 apps at the same time. Roughly halves install time, but some MSI installers fail when run concurrently — disable if you see weird install errors." />
                    </StackPanel>

                    <ToggleSwitch x:Name="ParallelToggle"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="ParallelToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="6"
                       Text="App selection"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Export / Import card -->
            <Border Grid.Row="7"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE159;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Export / import selection"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SelectionStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Save your current selection to a JSON file and reload it on a fresh install or share with a friend." />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="ExportButton"
                                Click="ExportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton"
                                Click="ImportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="SelectionResultBar"
                     Grid.Row="8"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />
        </Grid>
    </ScrollView>
</Page>
