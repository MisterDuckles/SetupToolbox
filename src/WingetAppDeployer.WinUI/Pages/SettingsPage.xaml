<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WingetAppDeployer_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollView VerticalScrollBarVisibility="Auto"
                ScrollAnimationStarting="ScrollView_ScrollAnimationStarting">
        <Grid Padding="36,24,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Settings"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,20" />

            <TextBlock Grid.Row="1"
                       Text="Auto-updates"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <!-- Auto-update schedule card -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE823;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Scheduled auto-updates"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ScheduleStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Checking status..." />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="DisableButton"
                                Click="DisableButton_Click"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Disable" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScheduleButton"
                                Click="ScheduleButton_Click"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE787;" FontSize="14" />
                                <TextBlock x:Name="ScheduleButtonText" Text="Set up" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3"
                       Text="Installation"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Manual download fallback toggle -->
            <Border Grid.Row="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE71B;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Open vendor download pages"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="When installing apps that aren't on winget (badged 'Manual download'), open the vendor's download page in your default browser. Disable to skip these apps during install." />
                    </StackPanel>

                    <ToggleSwitch x:Name="FallbackToggle"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="FallbackToggle_Toggled" />
                </Grid>
            </Border>

            <!-- Parallel installs toggle -->
            <Border Grid.Row="5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16"
                    Margin="0,8,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE9F5;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Run installs in parallel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Install up to 2 apps at the same time. Roughly halves install time, but some MSI installers fail when run concurrently — disable if you see weird install errors." />
                    </StackPanel>

                    <ToggleSwitch x:Name="ParallelToggle"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="ParallelToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="6"
                       Text="Uninstall"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Leftover scan after uninstall toggle -->
            <Border Grid.Row="7"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE74D;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Scan for leftovers after uninstall"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="After a successful uninstall, scan registry uninstall keys, Program Files folders and AppData folders for leftover traces. Always preview — niets wordt verwijderd zonder bevestiging." />
                    </StackPanel>

                    <ToggleSwitch x:Name="LeftoverToggle"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Toggled="LeftoverToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="8"
                       Text="App selection"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <!-- Export / Import card -->
            <Border Grid.Row="9"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE159;"
                              FontSize="20"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Export / import selection"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="SelectionStatusText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Save your current selection to a JSON file and reload it on a fresh install or share with a friend." />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="ExportButton"
                                Click="ExportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton"
                                Click="ImportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="Import" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="SelectionResultBar"
                     Grid.Row="10"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />

            <!-- ── BACKUP & HERSTEL (Tweaks snapshots) ── -->
            <TextBlock Grid.Row="11"
                       Text="Backup &amp; herstel"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE7B8;"
                              FontSize="20"
                              VerticalAlignment="Top"
                              Margin="0,6,0,0"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Backup voor Tweaks Apply"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Wij maken een snapshot van alle registry-waardes die door je Tweaks-keuzes geraakt worden, vóór de Apply. De knop 'Vorige staat herstellen' op de Tweaks tab zet alles dan exact terug." />

                        <RadioButtons x:Name="BackupModeRadios"
                                      SelectionChanged="BackupModeRadios_SelectionChanged"
                                      Margin="0,8,0,0">
                            <RadioButton Content="Vraag elke keer (aanbevolen)" Tag="Ask" />
                            <RadioButton Content="Altijd automatisch backup" Tag="Always" />
                            <RadioButton Content="Nooit backup maken" Tag="Never" />
                        </RadioButtons>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="BrowseSnapshotsButton"
                            Click="BrowseSnapshotsButton_Click"
                            VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock x:Name="BrowseSnapshotsText" Text="Bekijk snapshots..." />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ── SYSTEM RESTORE POINTS (Deep Clean + Debloat) ── -->
            <TextBlock Grid.Row="13"
                       Text="System Restore Points"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,12" />

            <Border Grid.Row="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE777;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Restore point voor Deep Clean"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DeepCleanRestorePointStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Voor elke delete-batch een Windows System Restore Point maken. Eén UAC-prompt voor het hele scenario (checkpoint + delete samen)." />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon x:Name="DeepCleanWarningGlyph"
                                      Glyph="&#xE7BA;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      Visibility="Collapsed"
                                      ToolTipService.ToolTip="" />
                            <ToggleSwitch x:Name="DeepCleanRestoreToggle"
                                          Toggled="DeepCleanRestoreToggle_Toggled" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE777;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Restore point voor Debloat"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DebloatRestorePointStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Voor elke uninstall-batch een Windows System Restore Point maken. Vangt OEM-driver of Windows-feature regressies op." />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon x:Name="DebloatWarningGlyph"
                                      Glyph="&#xE7BA;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                      Visibility="Collapsed"
                                      ToolTipService.ToolTip="" />
                            <ToggleSwitch x:Name="DebloatRestoreToggle"
                                          Toggled="DebloatRestoreToggle_Toggled" />
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="RestorePointGlobalStatus"
                             Severity="Informational"
                             IsOpen="False"
                             IsClosable="False" />

                    <!-- Restore points beheren: opent de Windows System Restore
                         wizard (rstrui.exe). Vanuit daar kan user een eerder
                         restore point selecteren en het systeem terugzetten —
                         dat zelf doen via PowerShell vereist reboot + admin en
                         is geen UX-winst tegenover de native wizard. -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE7A7;"
                                  FontSize="20"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Restore points beheren / terugzetten"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Opent de Windows System Restore wizard waar je een eerder restore point kunt selecteren om je systeem terug te zetten. Reboot is vereist voor de daadwerkelijke restore." />
                        </StackPanel>
                        <Button Grid.Column="2"
                                x:Name="OpenSystemRestoreButton"
                                Click="OpenSystemRestoreButton_Click"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock Text="Open wizard" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="BackupResultBar"
                     Grid.Row="15"
                     Severity="Informational"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,12,0,0" />
        </Grid>
    </ScrollView>
</Page>
