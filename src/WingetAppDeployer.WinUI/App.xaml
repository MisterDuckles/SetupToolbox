<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WingetAppDeployer_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WingetAppDeployer_WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Native Windows 11 rounded corners for dialogs, flyouts, and
                 popups. ContentDialog's template resolves OverlayCornerRadius
                 against the application resource dictionary, not the element's
                 own Resources, so it has to live here. -->
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
