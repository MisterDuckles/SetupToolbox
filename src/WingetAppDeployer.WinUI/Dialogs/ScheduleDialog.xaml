<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WingetAppDeployer_WinUI.Dialogs.ScheduleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Schedule auto-updates"
    PrimaryButtonText="Create schedule"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16">
        <TextBlock Text="Windows Task Scheduler runs this app with /autoupdate op het gekozen moment. Dan draait 'winget upgrade --all' stil op de achtergrond, zonder UI."
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Spacing="8">
            <TextBlock Text="Frequency"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButton x:Name="DailyRadio"
                         Content="Daily"
                         GroupName="ScheduleType"
                         IsChecked="True"
                         Checked="ScheduleRadio_Changed" />
            <RadioButton x:Name="WeeklyRadio"
                         Content="Weekly (every Monday)"
                         GroupName="ScheduleType"
                         Checked="ScheduleRadio_Changed" />
            <RadioButton x:Name="OnStartupRadio"
                         Content="On user logon"
                         GroupName="ScheduleType"
                         Checked="ScheduleRadio_Changed" />
        </StackPanel>

        <StackPanel x:Name="TimePanel" Spacing="8">
            <TextBlock Text="Time"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TimePicker x:Name="TimePickerCtrl"
                        ClockIdentifier="24HourClock"
                        HorizontalAlignment="Left"
                        MinuteIncrement="5" />
        </StackPanel>

        <InfoBar x:Name="ResultBar"
                 Severity="Informational"
                 IsOpen="False"
                 IsClosable="False" />
    </StackPanel>
</ContentDialog>
