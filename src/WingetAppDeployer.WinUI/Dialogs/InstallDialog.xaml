<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WingetAppDeployer_WinUI.Dialogs.InstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dialogs="using:WingetAppDeployer_WinUI.Dialogs"
    mc:Ignorable="d"
    Title="Install apps"
    PrimaryButtonText="Close"
    IsPrimaryButtonEnabled="False"
    DefaultButton="Primary">

    <Grid Width="560" MinHeight="260">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ProgressHeader"
                   Text="Preparing..."
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="380">
            <ItemsControl x:Name="AppItemList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:InstallItem">
                        <Grid Padding="0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="90" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      FontSize="16"
                                      Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                      VerticalAlignment="Top"
                                      Margin="0,2,0,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource BodyTextBlockStyle}" />

                                <!-- Indeterminate bar during install -->
                                <ProgressBar Width="150"
                                             HorizontalAlignment="Left"
                                             IsIndeterminate="True"
                                             ShowPaused="False"
                                             ShowError="False"
                                             Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />

                                <!-- Live winget stdout line (e.g. "97.3 MB / 154 MB") -->
                                <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind MessageVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind StateLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
