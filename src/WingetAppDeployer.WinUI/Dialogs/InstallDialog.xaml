<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="WingetAppDeployer_WinUI.Dialogs.InstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dialogs="using:WingetAppDeployer_WinUI.Dialogs"
    mc:Ignorable="d"
    Title="Install apps"
    PrimaryButtonText="Close"
    IsPrimaryButtonEnabled="False"
    DefaultButton="Primary">

    <Grid Width="520" MinHeight="300">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
            <TextBlock x:Name="ProgressHeader"
                       Text="Preparing..."
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="ProgressDetail"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ProgressBar Grid.Row="1"
                     x:Name="OverallProgress"
                     Value="0"
                     Maximum="1"
                     Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320">
            <ItemsControl x:Name="AppItemList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:InstallItem">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="{x:Bind Glyph, Mode=OneWay}"
                                      FontSize="16"
                                      Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind HasMessage, Mode=OneWay}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind StateLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{x:Bind IconBrush, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
